APP_ENV=development
APIFY_API_TOKEN=

# Actor IDs are configurable so an Actor can be replaced without touching business logic.
APIFY_INSTAGRAM_PROFILE_ACTOR=parseforge/instagram-posts-scraper
APIFY_INSTAGRAM_POST_ACTOR=parseforge/instagram-posts-scraper
APIFY_LINKEDIN_PROFILE_ACTOR=data-slayer/linkedin-profile-posts-scraper
APIFY_LINKEDIN_POST_ACTOR=fetch_cat/linkedin-posts-scraper
APIFY_FACEBOOK_PROFILE_ACTOR=spbotdel/facebook-profile-posts-all-photos-scraper
APIFY_FACEBOOK_POST_ACTOR=scrapyspider/facebook-post-scraper
APIFY_REDDIT_PROFILE_ACTOR=scrapers_lat/reddit-scraper
APIFY_REDDIT_POST_ACTOR=scrapers_lat/reddit-scraper

MAX_POSTS_PER_PROFILE=30
MAX_CANDIDATES=50
FACE_MATCH_THRESHOLD=0.45

BASE_SEPOLIA_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
EVIDENCE_REGISTRY_ADDRESS=

DATA_DIR=./var
